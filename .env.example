# Optional for the Windows widget. A saved connection.xml takes precedence.
# Copy this file to .env and fill in only the fields for your connection mode.
ECOFLOW_MODE=public
ECOFLOW_REGION=eu
ECOFLOW_SERIAL=

# public: EcoFlow developer credentials (read-only)
ECOFLOW_ACCESS_KEY=
ECOFLOW_SECRET_KEY=

# private: EcoFlow app credentials (unofficial integration)
ECOFLOW_EMAIL=
ECOFLOW_PASSWORD=
